#!/bin/bash

#SBATCH --partition=genoa
#SBATCH --job-name=PengwinBoxes
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=6:00:00
#SBATCH --output=snellius-scripts/slurm_output_pengwin_boxes_%A.out

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source activate MoE

cd /home/scur0509/projects/MoE-ShapeRefine-MedicalSeg

echo "job id: ${SLURM_JOB_ID:-unknown}"
echo "host: $(hostname)"
echo "start: $(date)"
echo "cwd: $(pwd)"
echo "SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK:-unset}"

# You can override these when submitting, for example:
# sbatch --export=ALL,LOG_EVERY=500 prepare_pengwin_boxes.job
LOG_EVERY="${LOG_EVERY:-500}"

echo "LOG_EVERY=${LOG_EVERY}"

python src/prepare_pengwin_xray_boxes_for_medsam_inference.py \
  --resume \
  --verbose \
  --log-every "${LOG_EVERY}"

echo "end: $(date)"
