#!/bin/bash

#SBATCH --partition=rome
#SBATCH --job-name=summarize_medsam_finetuned
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --time=00:15:00
#SBATCH --output=/gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg/src/medsam-finetuned/jobs-slurmOutputs/slurm_summarize_medsam_finetuned_%A.out

# Generates summary CSVs and prints metric tables from the evaluation CSV.
# Chained after 2_evaluate_medsam_finetuned.job via submit_pipeline.sh.
#
# Outputs:
#   data/medsam-finetuned-predictions/summary_full.csv   — all metrics (Dice, IoU, HD95, ASSD)
#   data/medsam-finetuned-predictions/summary_overlap.csv — Dice + IoU only

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "========================================"

echo ""
echo "=== Full metrics (Dice, IoU, HD95, ASSD) ==="
python evaluation/summarize_eval_csv.py \
    data/medsam-finetuned-predictions/evaluation_pengwin.csv \
    --summary-csv data/medsam-finetuned-predictions/summary_full.csv

echo ""
echo "=== Overlap metrics only (Dice, IoU) ==="
python evaluation/summarize_eval_csv.py \
    data/medsam-finetuned-predictions/evaluation_pengwin.csv \
    --metrics dice iou \
    --summary-csv data/medsam-finetuned-predictions/summary_overlap.csv

echo "========================================"
echo "end : $(date)"
echo "========================================"
