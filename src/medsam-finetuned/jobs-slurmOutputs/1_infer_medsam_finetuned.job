#!/bin/bash

#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=infer_medsam_finetuned
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=04:00:00
#SBATCH --output=/gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg/src/medsam-finetuned/jobs-slurmOutputs/slurm_infer_medsam_finetuned_%A.out

# Runs MedSAM inference with the fine-tuned checkpoint (ioana-checkpoint).
# Uses the same bounding-box prompts as the base MedSAM run but overwrites
# the image encoder / decoder weights with the fine-tuned ones.
# Output goes to data/medsam-finetuned-predictions/ — same layout as
# data/medsam-predictions/ so evaluate_medsam_pengwin.py can read it unchanged.

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "========================================"

python src/run_medsam_with_pengwin_boxes.py \
    --output-root     data/medsam-finetuned-predictions \
    --checkpoint  /gpfs/home5/scur0509/projects/MedSAM/ioana-checkpoint/medsam_pengwin_best.pth \
    --resume

echo "========================================"
echo "end : $(date)"
echo "========================================"
