#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=infer_medsam_base
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=06batch src/FlowSDF/train_flowsdf_moe.job:00:00
#SBATCH --output=/gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg/src/medsam-base/jobs-slurmOutputs/slurm_infer_medsam_base_%A.out

# Runs MedSAM inference using the original base checkpoint (medsam_vit_b.pth),
# no fine-tuning applied. Output goes to data/medsam-predictions/ — this is
# the directory expected by gating_mechanism.py and train_flowsdf_moe.py.

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "========================================"

python src/run_medsam_with_pengwin_boxes.py \
    --output-root data/medsam-predictions \
    --resume

echo "========================================"
echo "end : $(date)"
echo "========================================"
