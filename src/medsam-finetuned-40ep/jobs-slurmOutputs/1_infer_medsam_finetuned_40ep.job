#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=infer_medsam_finetuned_40ep
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=04:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/medsam-finetuned-40ep/jobs-slurmOutputs/slurm_infer_medsam_finetuned_40ep_%A.out

# Runs MedSAM inference with the full 40-epoch fine-tuned checkpoint from
# 3_train_medsam_pengwin_40ep.job (medsam-finetuned-40ep/medsam_pengwin_best.pth).
# Output goes to data/medsam-finetuned-40ep-predictions/ — same layout as
# data/medsam-finetuned-20ep-predictions/ so evaluate_medsam_pengwin.py can read it unchanged.

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "========================================"

python src/run_medsam_with_pengwin_boxes.py \
    --output-root     data/medsam-finetuned-40ep-predictions \
    --finetuned-ckpt  /scratch-shared/aramautar2/checkpoints/medsam-finetuned-40ep/medsam_pengwin_best.pth \
    --resume

echo "========================================"
echo "end : $(date)"
echo "========================================"
