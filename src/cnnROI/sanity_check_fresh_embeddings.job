#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=sanity_check_cnnroi
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=00:30:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/cnnROI/sanity_check_%A.out

# Sanity-checks the already-trained cnnROI experts (checkpoints/cnnROI,
# trained 2026-07-03/04) against the freshly-regenerated MedSAM embeddings
# (2026-08-19, job 25804827 --resume) on a small slice of the test split.
#
# This is the check that would catch a FlowSDF-style train/inference
# mismatch (see project_flowsdf_stepsize_migration memory) before it poisons
# oracle_route.py's oracle labels. If mean dice looks collapsed relative to
# the historical ~0.85-0.9 range, cnnROI needs retraining before oracle
# routing/learned gating can be trusted.
#
# Output:
#   /scratch-shared/aramautar2/sanity_check_cnnroi/evaluation_sanity.csv

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "========================================"

SANITY_DIR=/scratch-shared/aramautar2/sanity_check_cnnroi
PRED_DIR=$SANITY_DIR/binary_masks
mkdir -p "$PRED_DIR"

echo ""
echo "--- Step 1: cnnROI inference, 200 test images ---"
python src/cnnROI/infer_roi.py \
    --split test \
    --limit 200 \
    --output-dir "$PRED_DIR"

echo ""
echo "--- Step 2: evaluate against PENGWIN GT (dice + iou only, + delta vs MedSAM baseline) ---"
python evaluation/evaluate_moe_pengwin.py \
    --pred-mask-root "$PRED_DIR" \
    --output-csv     "$SANITY_DIR/evaluation_sanity.csv" \
    --medsam-csv     data/medsam-predictions/evaluation_pengwin.csv \
    --delta-csv      "$SANITY_DIR/evaluation_sanity_delta.csv" \
    --skip-boundary \
    --delta \
    --num-workers 8

echo ""
echo "=== sanity check summary (cnnROI on fresh embeddings) ==="
python evaluation/summarize_eval_csv.py "$SANITY_DIR/evaluation_sanity.csv"

echo "========================================"
echo "end : $(date)"
echo "========================================"
