#!/bin/bash

#SBATCH --partition=rome
#SBATCH --job-name=visualize_roi_cnnROI
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --time=00:30:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/cnnROI/jobs-slurmOutputs/slurm_visualize_roi_%A.out

# Generates side-by-side PNG figures for selected cnnROI fragments:
#   X-ray | MedSAM | cnnROI refined | GT | Diff
# Requires 2_infer_roi.job and 4_evaluate_roi.job to have completed first
# (needs data/roi-predictions/evaluation_delta.csv).
#
# Output: data/roi-predictions/visualizations/*.png

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id : ${SLURM_JOB_ID}"
echo "host   : $(hostname)"
echo "start  : $(date)"
echo "========================================"

python evaluation/visualize_moe_pengwin.py \
    --moe-mask-root  data/roi-predictions/binary_masks \
    --delta-csv      data/roi-predictions/evaluation_delta.csv \
    --output-dir     data/roi-predictions/visualizations \
    --n-best 5 \
    --n-worst 5 \
    --n-random-small 5 \
    --n-random-large 5

echo "========================================"
echo "end : $(date)"
echo "========================================"
