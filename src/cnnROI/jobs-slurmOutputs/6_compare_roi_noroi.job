#!/bin/bash

#SBATCH --partition=rome
#SBATCH --job-name=compare_roi_noroi
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --time=00:30:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/cnnROI/jobs-slurmOutputs/slurm_compare_roi_noroi_%A.out

# Direct comparison of cnnROI vs cnnNoROI.
# Requires both evaluation jobs to have completed:
#   - cnnNoROI: data/moe-predictions/evaluation_moe.csv
#   - cnnROI:   data/roi-predictions/evaluation_roi.csv
#
# Outputs:
#   data/roi-predictions/comparisons/*.png
#     6-panel figures: X-ray | MedSAM | cnnNoROI | cnnROI | GT | Diff(RoI vs NoRoI)
#   Printed metrics table in this .out file (MedSAM → cnnNoROI → cnnROI per group)

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id : ${SLURM_JOB_ID}"
echo "host   : $(hostname)"
echo "start  : $(date)"
echo "========================================"

python evaluation/compare_roi_noroi_pengwin.py \
    --n-roi-wins 5 \
    --n-roi-loses 5 \
    --n-random-small 5 \
    --n-random-large 5

echo "========================================"
echo "end : $(date)"
echo "========================================"
