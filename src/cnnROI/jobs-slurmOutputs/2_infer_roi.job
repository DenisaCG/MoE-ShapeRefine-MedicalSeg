#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=infer_roi_cnnROI
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/cnnROI/jobs-slurmOutputs/slurm_infer_roi_%A.out

# Runs infer_roi.py on the test split.
# Requires 1_train_roi_cnn.job to have completed (needs *_best.pth checkpoints).
# Output: data/roi-predictions/binary_masks/{sample_name}.npz
# roi-size and roi-pad must match the values used during training.

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "========================================"

python src/cnnROI/infer_roi.py \
    --split test \
    --checkpoint-dir checkpoints/cnnROI \
    --output-dir data/roi-predictions/binary_masks \
    --roi-size 64 \
    --roi-pad 64

echo "========================================"
echo "end : $(date)"
echo "========================================"
