#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=train_roi_cnnROI
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=04:00:00
#SBATCH --output=/gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg/src/cnnROI/jobs-slurmOutputs/slurm_train_roi_%A.out

# Identical resource allocation to cnnNoROI training job.
# Per-sample bbox extraction (CPU) adds minor overhead vs cnnNoROI's
# global resize, but the model and batch size are unchanged.

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "python  : $(which python)"
echo "========================================"

python src/cnnROI/train_roi.py \
    --expert both \
    --epochs 20 \
    --batch-size 64 \
    --num-workers 8 \
    --large-subsample 17000 \
    --roi-size 64 \
    --roi-pad 64 \
    --wandb-project moe-shaprefine

echo "========================================"
echo "end : $(date)"
echo "========================================"
