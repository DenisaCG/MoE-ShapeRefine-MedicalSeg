#!/bin/bash

#SBATCH --partition=rome
#SBATCH --job-name=evaluate_medsam_finetuned_20ep
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=04:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/medsam-finetuned-20ep/jobs-slurmOutputs/slurm_evaluate_medsam_finetuned_20ep_%A.out

# Evaluates the 20-epoch fine-tuned MedSAM predictions against PENGWIN GT.
# Reads masks from data/medsam-finetuned-20ep-predictions/binary_masks/.
# Produces data/medsam-finetuned-20ep-predictions/evaluation_pengwin.csv.
# Chained after 1_infer_medsam_finetuned_20ep.job via submit_pipeline.sh.

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "========================================"

python evaluation/evaluate_medsam_pengwin.py \
    --pred-metadata   data/medsam-finetuned-20ep-predictions/metadata.jsonl \
    --pred-mask-root  data/medsam-finetuned-20ep-predictions/binary_masks \
    --output-csv      data/medsam-finetuned-20ep-predictions/evaluation_pengwin.csv \
    --num-workers     16

echo "========================================"
echo "end : $(date)"
echo "========================================"
