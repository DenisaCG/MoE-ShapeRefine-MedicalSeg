#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=smoke_train_moe_sam
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=00:30:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/sam-base/output/slurm_smoke_train_moe_sam_%A.out

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "python  : $(which python)"
echo "========================================"

SMOKE_DIR=src/sam-base/smoke_test
GATING_CSV_DIR=$SMOKE_DIR/gating_csvs
CHECKPOINT_DIR=$SMOKE_DIR/checkpoints

mkdir -p "$GATING_CSV_DIR" "$CHECKPOINT_DIR"

echo ""
echo "--- Step 1: smoke gating CSVs from data/sam-predictions/metadata.jsonl ---"
python src/gating_mechanism/gating_mechanism.py \
    --smoke \
    --metadata-path data/sam-predictions/metadata.jsonl \
    --out-dir "$GATING_CSV_DIR"

echo ""
echo "--- Step 2: verify train_moe_sam.py starts with --gating-csv-dir (expert_large, 1 epoch) ---"
python src/cnnNoROI/train_moe_sam.py \
    --expert expert_large \
    --epochs 1 \
    --patience 1 \
    --batch-size 2 \
    --num-workers 2 \
    --gating-csv-dir "$GATING_CSV_DIR" \
    --checkpoint-dir "$CHECKPOINT_DIR" \
    --no-wandb

echo ""
echo "Smoke test finished — SAM gating CSV generation and train_moe_sam.py --gating-csv-dir startup both verified."

echo "========================================"
echo "end : $(date)"
echo "========================================"
