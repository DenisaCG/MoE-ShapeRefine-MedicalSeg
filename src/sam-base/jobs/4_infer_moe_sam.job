#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=infer_moe_cnnNoROI_sam
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/sam-base/output/slurm_infer_moe_sam_%A.out

# SAM (plain, no medical fine-tuning) variant of the cnnNoROI inference job.
# Model-agnosticism check (Daua's open item) -- runs the trained
# checkpoints/cnnNoROI-sam experts on the test split, refining SAM's raw
# masks the same way MedSAM's were refined for data/moe-predictions/.
#
# Requires 3_train_moe_cnn_sam.job to have completed first --
# checkpoints/cnnNoROI-sam/{expert_small,expert_large}_best.pth must exist.
#
# Output: data/sam-moe-predictions/binary_masks/{sample_name}.npz

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "python  : $(which python)"
echo "========================================"

python src/cnnNoROI/infer_moe_sam.py \
    --split test \
    --gating-csv-dir data/sam-predictions/gating \
    --checkpoint-dir checkpoints/cnnNoROI-sam \
    --output-dir data/sam-moe-predictions/binary_masks

echo "========================================"
echo "end : $(date)"
echo "========================================"
