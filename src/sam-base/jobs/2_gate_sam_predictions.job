#!/bin/bash

#SBATCH --partition=rome
#SBATCH --job-name=gate_sam_predictions
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/sam-base/output/slurm_gate_sam_predictions_%A.out

# Runs gating_mechanism.py against data/sam-predictions/metadata.jsonl (plain
# SAM, no medical fine-tuning) instead of the canonical data/medsam-predictions/.
# Model-agnosticism check (Daua's open item) -- CPU-only (numpy mask-area
# reduction over precomputed .npz masks), no GPU needed.
#
# Requires 1_infer_sam_base.job to have completed first -- data/sam-predictions/
# metadata.jsonl must exist.
#
# Output: data/sam-predictions/gating/gated_{train,val,test}_records.csv
# The canonical CSVs in src/gating_mechanism/ are untouched.

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "python  : $(which python)"
echo "========================================"

python src/gating_mechanism/gating_mechanism.py \
    --metadata-path data/sam-predictions/metadata.jsonl \
    --out-dir data/sam-predictions/gating

echo "========================================"
echo "end : $(date)"
echo "========================================"
