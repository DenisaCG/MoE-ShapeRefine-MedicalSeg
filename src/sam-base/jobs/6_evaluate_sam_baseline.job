#!/bin/bash

#SBATCH --partition=rome
#SBATCH --job-name=evaluate_sam_baseline
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/sam-base/output/slurm_evaluate_sam_baseline_%A.out

# Evaluates plain SAM's RAW (unrefined, no cnnNoROI) predictions against
# PENGWIN GT -- the missing baseline for the model-agnosticism ablation.
# Restricted to the same 5,000-image test split used for cnnNoROI(SAM), by
# symlinking just those raw masks into a filtered directory first (SAM's
# data/sam-predictions/binary_masks/ holds all 50k train+val+test images).
#
# Requires 1_infer_sam_base.job and 2_gate_sam_predictions.job to have
# completed (both already have) -- reads
# data/sam-predictions/gating/gated_test_records.csv for the test sample list.
#
# Then computes delta: cnnNoROI(SAM) [data/sam-moe-predictions/evaluation_moe.csv]
# minus raw SAM baseline -- the actual "does refinement help" comparison,
# independent of SAM vs MedSAM absolute strength.
#
# Outputs:
#   data/sam-predictions/evaluation_sam_baseline_test.csv
#   data/sam-moe-predictions/evaluation_delta_vs_sam_baseline.csv

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "python  : $(which python)"
echo "========================================"

TEST_ONLY_DIR=data/sam-predictions/binary_masks_test_only
mkdir -p "$TEST_ONLY_DIR"

echo ""
echo "--- Step 1: symlink raw SAM test-split masks (5,000 images) ---"
python - <<'PYEOF'
import pandas as pd
from pathlib import Path

df = pd.read_csv("data/sam-predictions/gating/gated_test_records.csv")
sample_names = df["sample_name"].unique()
src_dir = Path("data/sam-predictions/binary_masks")
dst_dir = Path("data/sam-predictions/binary_masks_test_only")

n_linked, n_missing = 0, 0
for name in sample_names:
    src = src_dir / f"{name}.npz"
    dst = dst_dir / f"{name}.npz"
    if not src.exists():
        n_missing += 1
        continue
    if not dst.exists():
        dst.symlink_to(src.resolve())
    n_linked += 1

print(f"Linked {n_linked} test-split masks ({n_missing} missing) into {dst_dir}/")
PYEOF

echo ""
echo "--- Step 2: evaluate raw SAM baseline on the test split ---"
python evaluation/evaluate_moe_pengwin.py \
    --pred-mask-root "$TEST_ONLY_DIR" \
    --pred-metadata  data/sam-predictions/metadata.jsonl \
    --output-csv     data/sam-predictions/evaluation_sam_baseline_test.csv \
    --num-workers 8

echo ""
echo "=== raw SAM baseline (test split) summary ==="
python evaluation/summarize_eval_csv.py data/sam-predictions/evaluation_sam_baseline_test.csv

echo ""
echo "--- Step 3: delta -- cnnNoROI(SAM) vs raw SAM baseline ---"
python evaluation/evaluate_moe_pengwin.py \
    --delta-only \
    --output-csv data/sam-moe-predictions/evaluation_moe.csv \
    --medsam-csv data/sam-predictions/evaluation_sam_baseline_test.csv \
    --delta-csv  data/sam-moe-predictions/evaluation_delta_vs_sam_baseline.csv \
    --delta

echo "========================================"
echo "end : $(date)"
echo "========================================"
