#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=infer_sam_base
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=06:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/sam-base/output/slurm_infer_sam_base_%A.out

# Runs plain SAM (ViT-B, sam_vit_b_01ec64.pth, no medical fine-tuning) with the
# same Pengwin bounding boxes used for MedSAM inference. Model-agnosticism
# check for the pipeline's claims (open item flagged by Daua) -- output goes
# to data/sam-predictions/, kept separate from data/medsam-predictions/.

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "========================================"

python src/run_medsam_with_pengwin_boxes.py \
    --checkpoint /gpfs/home5/aramautar2/projects/MedSAM/work_dir/SAM/sam_vit_b_01ec64.pth \
    --model-type vit_b \
    --output-root data/sam-predictions \
    --resume

echo "========================================"
echo "end : $(date)"
echo "========================================"
