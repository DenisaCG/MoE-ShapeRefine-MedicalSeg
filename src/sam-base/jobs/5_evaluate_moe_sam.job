#!/bin/bash

#SBATCH --partition=rome
#SBATCH --job-name=evaluate_moe_cnnNoROI_sam
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/sam-base/output/slurm_evaluate_moe_sam_%A.out

# Evaluates SAM-trained cnnNoROI refined masks against PENGWIN GT (Dice, IoU,
# HD95, ASSD). Also computes a delta CSV vs the MedSAM baseline
# (data/medsam-predictions/evaluation_pengwin.csv, already exists) -- this is
# the actual model-agnosticism comparison (Daua's open item): does the
# pipeline's downstream pattern hold when the upstream segmenter is plain SAM
# instead of MedSAM. CPU-only, no GPU needed.
#
# Requires 4_infer_moe_sam.job to have completed first --
# data/sam-moe-predictions/binary_masks/*.npz must exist.
#
# Outputs:
#   data/sam-moe-predictions/evaluation_moe.csv     per-fragment metrics
#   data/sam-moe-predictions/evaluation_delta.csv   SAM-cnnNoROI - MedSAM delta per fragment

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "python  : $(which python)"
echo "========================================"

python evaluation/evaluate_moe_pengwin.py \
    --pred-mask-root data/sam-moe-predictions/binary_masks \
    --pred-metadata  data/sam-predictions/metadata.jsonl \
    --output-csv     data/sam-moe-predictions/evaluation_moe.csv \
    --medsam-csv     data/medsam-predictions/evaluation_pengwin.csv \
    --delta-csv      data/sam-moe-predictions/evaluation_delta.csv \
    --num-workers 8 \
    --delta

echo ""
echo "=== SAM cnnNoROI evaluation summary ==="
python evaluation/summarize_eval_csv.py data/sam-moe-predictions/evaluation_moe.csv

echo "========================================"
echo "end : $(date)"
echo "========================================"
