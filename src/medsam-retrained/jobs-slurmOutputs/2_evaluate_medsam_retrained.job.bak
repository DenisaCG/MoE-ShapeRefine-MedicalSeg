#!/bin/bash

#SBATCH --partition=rome
#SBATCH --job-name=evaluate_medsam_retrained
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=04:00:00
#SBATCH --output=/gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg/src/medsam-retrained/jobs-slurmOutputs/slurm_evaluate_medsam_retrained_%A.out

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "========================================"

python evaluation/evaluate_medsam_pengwin.py \
    --pred-metadata  data/medsam-retrained-predictions/metadata.jsonl \
    --pred-mask-root data/medsam-retrained-predictions/binary_masks \
    --output-csv     data/medsam-retrained-predictions/evaluation_pengwin.csv \
    --num-workers    16

echo "========================================"
echo "end : $(date)"
echo "========================================"
