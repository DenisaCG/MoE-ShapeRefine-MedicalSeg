#!/bin/bash

#SBATCH --partition=rome
#SBATCH --job-name=summarize_medsam_retrained
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --time=00:30:00
#SBATCH --output=/gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg/src/medsam-retrained/jobs-slurmOutputs/slurm_summarize_medsam_retrained_%A.out

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "========================================"

# Filter evaluation CSV to test split only (avoids train-set leakage in metrics).
echo "=== Filtering to test split ==="
python -c "
import pandas as pd
test_samples = set(pd.read_csv('src/gating_mechanism/gated_test_records.csv')['sample_name'].unique())
df = pd.read_csv('data/medsam-retrained-predictions/evaluation_pengwin.csv')
df_test = df[df['sample_name'].isin(test_samples)]
df_test.to_csv('data/medsam-retrained-predictions/evaluation_pengwin_test.csv', index=False)
print(f'Test fragments: {len(df_test)} / {len(df)} total')
"

echo ""
echo "=== Full metrics — test split (Dice, IoU, HD95, ASSD) ==="
python evaluation/summarize_eval_csv.py \
    data/medsam-retrained-predictions/evaluation_pengwin_test.csv \
    --summary-csv data/medsam-retrained-predictions/summary_full.csv

echo ""
echo "=== Overlap metrics — test split (Dice, IoU) ==="
python evaluation/summarize_eval_csv.py \
    data/medsam-retrained-predictions/evaluation_pengwin_test.csv \
    --metrics dice iou \
    --summary-csv data/medsam-retrained-predictions/summary_overlap.csv

echo "========================================"
echo "end : $(date)"
echo "========================================"
