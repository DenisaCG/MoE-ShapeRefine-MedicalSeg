#!/bin/bash

#SBATCH --partition=rome
#SBATCH --job-name=compare_flowsdf_stepsizes
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --time=01:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/FlowSDF/jobs-slurmOutputs/slurm_compare_flowsdf_stepsizes_%A.out

# Three-way comparison of FlowSDF ODE step counts: stepsize_10 vs stepsize_40
# vs stepsize_60. Requires 2_infer_flowsdf.job + 4_evaluate_flowsdf.job to have
# completed for all three ODE_STEPS values (10, 40, 60), i.e.:
#   data/flowsdf-moe-predictions/test/stepsize_{10,40,60}/csv/evaluation_flowsdf.csv
#   data/flowsdf-moe-predictions/test/stepsize_{10,40,60}/binary_masks/
#
# Outputs:
#   data/flowsdf-moe-predictions/test/stepsize_comparison/csv/stepsize_comparison_merged.csv
#     (per-fragment dice/iou/hd95/assd for all 3 step counts + winner_stepsize column)
#   data/flowsdf-moe-predictions/test/stepsize_comparison/verdict.txt
#     (overall best-performing step count, with mean-metric and win-count evidence)
#   data/flowsdf-moe-predictions/test/stepsize_comparison/comparisons/*.png
#     6-panel figures: X-ray | stepsize_10 | stepsize_40 | stepsize_60 | GT | Diff
#   Printed per-group metrics table + verdict in this .out file.

set -euo pipefail

RUN_DIR="data/flowsdf-moe-predictions/test"

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

export MPLCONFIGDIR="${TMPDIR:-/tmp}/matplotlib-${SLURM_JOB_ID}"
export XDG_CACHE_HOME="${TMPDIR:-/tmp}/cache-${SLURM_JOB_ID}"
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id : ${SLURM_JOB_ID}"
echo "host   : $(hostname)"
echo "start  : $(date)"
echo "python : $(which python)"
echo "========================================"

python evaluation/compare_flowsdf_stepsizes.py \
    --csv-10 "${RUN_DIR}/stepsize_10/csv/evaluation_flowsdf.csv" \
    --csv-40 "${RUN_DIR}/stepsize_40/csv/evaluation_flowsdf.csv" \
    --csv-60 "${RUN_DIR}/stepsize_60/csv/evaluation_flowsdf.csv" \
    --mask-root-10 "${RUN_DIR}/stepsize_10/binary_masks" \
    --mask-root-40 "${RUN_DIR}/stepsize_40/binary_masks" \
    --mask-root-60 "${RUN_DIR}/stepsize_60/binary_masks" \
    --output-dir "${RUN_DIR}/stepsize_comparison" \
    --n-max-disagreement 5 \
    --n-winner-best 5 \
    --n-winner-worst 5 \
    --n-random-small 5 \
    --n-random-large 5 \
    --seed 42

echo "========================================"
echo "end : $(date)"
echo "========================================"
