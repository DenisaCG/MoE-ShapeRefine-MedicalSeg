#!/bin/bash

#SBATCH --partition=rome
#SBATCH --job-name=evaluate_flowsdf_FlowSDF
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg/src/FlowSDF/jobs-slurmOutputs/slurm_evaluate_flowsdf_%A.out

# Evaluates FlowSDF MoE refined masks against PENGWIN GT (Dice, IoU, HD95, ASSD).
# Also computes a delta CSV comparing FlowSDF vs the MedSAM baseline per fragment.
# Requires 2_infer_flowsdf.job to have completed.
# Uses the same MedSAM baseline CSV and metadata as cnnROI/cnnNoROI.
#
# Outputs:
#   data/flowsdf-moe-predictions/test/evaluation_flowsdf.csv
#   data/flowsdf-moe-predictions/test/evaluation_delta.csv

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "python  : $(which python)"
echo "========================================"

# Step 1 - evaluate FlowSDF predictions (full metrics including HD95 and ASSD)
python evaluation/evaluate_moe_pengwin.py \
    --pred-mask-root  data/flowsdf-moe-predictions/test/binary_masks \
    --pred-metadata   data/medsam-predictions/metadata.jsonl \
    --output-csv      data/flowsdf-moe-predictions/test/evaluation_flowsdf.csv \
    --medsam-csv      data/medsam-predictions/evaluation_pengwin.csv \
    --delta-csv       data/flowsdf-moe-predictions/test/evaluation_delta.csv \
    --num-workers 8 \
    --delta

# Step 2 - print clean per-class / per-size summary for FlowSDF
echo ""
echo "=== FlowSDF evaluation summary ==="
python evaluation/summarize_eval_csv.py \
    data/flowsdf-moe-predictions/test/evaluation_flowsdf.csv

# Step 3 - print cnnROI summary for direct comparison
echo ""
echo "=== cnnROI evaluation summary (for comparison) ==="
python evaluation/summarize_eval_csv.py \
    data/roi-predictions/evaluation_roi.csv 2>/dev/null || \
    echo "cnnROI CSV not found - run cnnROI evaluate job first."

# Step 4 - print cnnNoROI summary for direct comparison
echo ""
echo "=== cnnNoROI evaluation summary (for comparison) ==="
python evaluation/summarize_eval_csv.py \
    data/moe-predictions/evaluation_moe.csv 2>/dev/null || \
    echo "cnnNoROI CSV not found - run cnnNoROI evaluate job first."

# Step 5 - print MedSAM baseline
echo ""
echo "=== MedSAM baseline summary ==="
python evaluation/summarize_eval_csv.py \
    data/medsam-predictions/evaluation_pengwin.csv 2>/dev/null || \
    echo "MedSAM baseline CSV not found."

echo "========================================"
echo "end : $(date)"
echo "========================================"
