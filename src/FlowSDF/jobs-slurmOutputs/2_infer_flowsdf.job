#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=infer_flowsdf_FlowSDF
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=06:00:00
#SBATCH --output=/gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg/src/FlowSDF/jobs-slurmOutputs/slurm_infer_flowsdf_%A.out

# Runs infer_flowsdf_moe.py on the test split.
# Requires train_flowsdf_moe.job to have completed (needs expert_*_best.pth checkpoints).
# Uses the same gated test records, MedSAM masks, and PENGWIN images as cnnROI/cnnNoROI.
#
# Output:
#   data/flowsdf-moe-predictions/test/binary_masks/{sample_name}.npz
#   data/flowsdf-moe-predictions/test/metadata.jsonl

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate flowSDF

cd /gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "python  : $(which python)"
echo "========================================"

python src/FlowSDF/infer_flowsdf_moe.py \
    --split test \
    --checkpoint-dir checkpoints/flowsdf \
    --checkpoint-suffix best \
    --state-key ema_state \
    --output-root data/flowsdf-moe-predictions \
    --img-size 128 \
    --ode-steps 4 \
    --n-eval 1 \
    --skip-existing

echo "========================================"
echo "end : $(date)"
echo "========================================"
