#!/bin/bash

#SBATCH --partition=rome
#SBATCH --job-name=annotate_existing_comparison
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --time=00:10:00
#SBATCH --output=/gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg/src/FlowSDF/jobs-slurmOutputs/slurm_annotate_existing_comparison_%A.out

# Adds lower-right Dice / delta-vs-MedSAM overlays to an already-rendered
# comparison PNG. This does not require binary masks; it reads scores from the
# evaluation CSVs and writes an annotated copy.
#
# Output:
#   data/flowsdf-moe-predictions/test/comparisons/stepsize_4/annotated/

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id : ${SLURM_JOB_ID}"
echo "host   : $(hostname)"
echo "start  : $(date)"
echo "python : $(which python)"
echo "========================================"

python evaluation/annotate_existing_comparison_png.py \
    --image data/flowsdf-moe-predictions/test/comparisons/stepsize_4/random_large__XRAY_PENGWIN_011_0118__frag000__SA__large__delta-0.053.png \
    --output-dir data/flowsdf-moe-predictions/test/comparisons/stepsize_4/annotated \
    --panel-order "X-ray,MedSAM,cnnNoROI,cnnROI,FlowSDF,Ground truth,Diff"

echo "========================================"
echo "end : $(date)"
echo "========================================"
