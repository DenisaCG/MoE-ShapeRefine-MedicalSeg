#!/bin/bash

#SBATCH --partition=rome
#SBATCH --job-name=compare_flowsdf_cnn
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --time=00:30:00
#SBATCH --output=/gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg/src/FlowSDF/jobs-slurmOutputs/slurm_compare_flowsdf_cnn_%A.out

# Combined visual comparison of cnnNoROI, cnnROI, and FlowSDF.
# Requires evaluation jobs to have completed:
#   - cnnNoROI: data/moe-predictions/evaluation_moe.csv
#   - cnnROI:   data/roi-predictions/evaluation_roi.csv
#   - FlowSDF:  data/flowsdf-moe-predictions/test/evaluation_flowsdf.csv
#
# Outputs:
#   data/flowsdf-moe-predictions/test/comparisons/*.png
#     7-panel figures: X-ray | MedSAM | cnnNoROI | cnnROI | FlowSDF | GT | Diff(RoI vs NoRoI)
#   Printed metrics table in this .out file.

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

export MPLCONFIGDIR="${TMPDIR:-/tmp}/matplotlib-${SLURM_JOB_ID}"
export XDG_CACHE_HOME="${TMPDIR:-/tmp}/cache-${SLURM_JOB_ID}"
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

cd /gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id : ${SLURM_JOB_ID}"
echo "host   : $(hostname)"
echo "start  : $(date)"
echo "========================================"

python evaluation/compare_roi_noroi_pengwin.py \
    --flowsdf-csv data/flowsdf-moe-predictions/test/evaluation_flowsdf.csv \
    --flowsdf-mask-root data/flowsdf-moe-predictions/test/binary_masks \
    --output-dir data/flowsdf-moe-predictions/test/comparisons \
    --n-roi-wins 5 \
    --n-roi-loses 5 \
    --n-random-small 5 \
    --n-random-large 5

echo "========================================"
echo "end : $(date)"
echo "========================================"
