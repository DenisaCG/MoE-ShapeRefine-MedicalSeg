#!/bin/bash

#SBATCH --partition=rome
#SBATCH --job-name=visualize_flowsdf_FlowSDF
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --time=00:30:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/FlowSDF/jobs-slurmOutputs/slurm_visualize_flowsdf_%A.out

# Generates side-by-side PNG figures for selected FlowSDF fragments:
#   X-ray | MedSAM | FlowSDF refined | GT | Diff
# Requires 2_infer_flowsdf.job and 4_evaluate_flowsdf.job to have completed first
# with the same ODE_STEPS value (needs both binary_masks/ and
# csv/evaluation_delta.csv under the matching stepsize_${ODE_STEPS} subfolder).
# Uses the same selection counts and seed as the cnnROI visualizer.
#
# Output (namespaced by ODE_STEPS so different step counts stay comparable):
#   data/flowsdf-moe-predictions/test/stepsize_${ODE_STEPS}/visualizations/*.png

set -euo pipefail

ODE_STEPS=60
RUN_DIR="data/flowsdf-moe-predictions/test/stepsize_${ODE_STEPS}"

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

export MPLCONFIGDIR="${TMPDIR:-/tmp}/matplotlib_${SLURM_JOB_ID}"
export XDG_CACHE_HOME="${TMPDIR:-/tmp}/xdg_cache_${SLURM_JOB_ID}"
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

echo "========================================"
echo "job id : ${SLURM_JOB_ID}"
echo "host   : $(hostname)"
echo "start  : $(date)"
echo "python : $(which python)"
echo "ode-steps: ${ODE_STEPS}"
echo "========================================"

python evaluation/visualize_moe_pengwin.py \
    --moe-mask-root  "${RUN_DIR}/binary_masks" \
    --delta-csv      "${RUN_DIR}/csv/evaluation_delta.csv" \
    --output-dir     "${RUN_DIR}/visualizations" \
    --method-label   "FlowSDF refined" \
    --n-best 5 \
    --n-worst 5 \
    --n-random-small 5 \
    --n-random-large 5 \
    --seed 42

echo "========================================"
echo "end : $(date)"
echo "========================================"
