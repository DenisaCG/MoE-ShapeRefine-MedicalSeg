#!/bin/bash

#SBATCH --partition=rome
#SBATCH --job-name=visualize_flowsdf_FlowSDF
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --time=00:30:00
#SBATCH --output=/gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg/src/FlowSDF/jobs-slurmOutputs/slurm_visualize_flowsdf_%A.out

# Generates side-by-side PNG figures for selected FlowSDF fragments:
#   X-ray | MedSAM | FlowSDF refined | GT | Diff
# Requires 2_infer_flowsdf.job and 4_evaluate_flowsdf.job to have completed first
# (needs data/flowsdf-moe-predictions/test/evaluation_delta.csv).
# Uses the same selection counts and seed as the cnnROI visualizer.
#
# Output: data/flowsdf-moe-predictions/test/visualizations/*.png

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg

export MPLCONFIGDIR="${TMPDIR:-/tmp}/matplotlib_${SLURM_JOB_ID}"
export XDG_CACHE_HOME="${TMPDIR:-/tmp}/xdg_cache_${SLURM_JOB_ID}"
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

echo "========================================"
echo "job id : ${SLURM_JOB_ID}"
echo "host   : $(hostname)"
echo "start  : $(date)"
echo "python : $(which python)"
echo "========================================"

python evaluation/visualize_moe_pengwin.py \
    --moe-mask-root  data/flowsdf-moe-predictions/test/binary_masks \
    --delta-csv      data/flowsdf-moe-predictions/test/evaluation_delta.csv \
    --output-dir     data/flowsdf-moe-predictions/test/visualizations \
    --method-label   "FlowSDF refined" \
    --n-best 5 \
    --n-worst 5 \
    --n-random-small 5 \
    --n-random-large 5 \
    --seed 42

echo "========================================"
echo "end : $(date)"
echo "========================================"
