#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=train_moe_flowsdf
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --mem=64G
#SBATCH --time=120:00:00
#SBATCH --output=/gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg/src/FlowSDF/slurm_train_flowsdf_%A.out

# cpus-per-task=9: standard allocation for one A100 GPU on Snellius.
# 8 CPUs go to DataLoader workers (--num-workers 8), 1 to the main process.
# mem=64G: increased from default to prevent swapping and I/O issues
# Time: 12 hours (increased buffer for safer checkpoint writing)
# Peak GPU usage for FlowSDF is typically 5-8 GB.

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate flowSDF

cd /gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg/src/FlowSDF

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "python  : $(which python)"
echo "========================================"

# ========== PRE-FLIGHT CHECKS ==========
echo ""
echo "Checking disk space and cleaning cache..."
GPFS_PATH="/gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg/src/FlowSDF"
GPFS_FREE=$(df -B1 "$GPFS_PATH" | tail -1 | awk '{print int($4 / 1e9)}')
echo "GPFS free space: ${GPFS_FREE} GB"
if [ "$GPFS_FREE" -lt 20 ]; then
    echo "WARNING: Less than 20 GB free on GPFS. Attempting cleanup..."
    # Remove old checkpoints and wandb logs (keep the last one)
    find "$GPFS_PATH/checkpoints" -type f -name "*.pth" -mtime +7 -delete 2>/dev/null || true
    find "$GPFS_PATH/wandb" -type d -mtime +7 -exec rm -rf {} + 2>/dev/null || true
    GPFS_FREE_AFTER=$(df -B1 "$GPFS_PATH" | tail -1 | awk '{print int($4 / 1e9)}')
    echo "After cleanup: ${GPFS_FREE_AFTER} GB"
fi

# Create tmp directory for safe checkpoint writes
mkdir -p /tmp/flowsdf_checkpoints_${SLURM_JOB_ID}
export TMPDIR="/tmp/flowsdf_checkpoints_${SLURM_JOB_ID}"
echo "Using TMPDIR for checkpoint writes: $TMPDIR"

echo ""
# echo ""
# echo "========================================"
# echo "SMOKE TEST: 2 epochs, small batch, 1 expert_small only"
# echo "========================================"
# python train_flowsdf_moe.py \
#     --expert expert_small \
#     --epochs 2 \
#     --batch-size 4 \
#     --num-workers 4 \
#     --img-size 128 \
#     --wandb-project moe-shaprefine

# if [ $? -ne 0 ]; then
#     echo "ERROR: Smoke test failed! Check for data/import issues before running full training."
#     exit 1
# fi

# echo ""
# echo "✓ Smoke test passed! Data loading and pipeline working."
# echo ""

# ========== FULL TRAINING ==========
echo "========================================"
echo "FULL TRAINING: 20 epochs, both experts"
echo "========================================"
python train_flowsdf_moe.py \
    --expert both \
    --epochs 20 \
    --batch-size 8 \
    --num-workers 8 \
    --img-size 128 \
    --large-subsample 17000 \
    --wandb-project moe-shaprefine \
    --resume

TRAIN_EXIT=$?

# Cleanup temporary checkpoint directory
if [ -n "${TMPDIR:-}" ] && [ -d "$TMPDIR" ]; then
    echo "Cleaning up temporary directory: $TMPDIR"
    rm -rf "$TMPDIR"
fi

echo ""
echo "========================================"
echo "end : $(date)"
if [ $TRAIN_EXIT -eq 0 ]; then
    echo "✓ Training finished successfully!"
else
    echo "✗ Training failed with exit code $TRAIN_EXIT"
fi
echo "========================================"
exit $TRAIN_EXIT

