#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=sanity_check_flowsdf
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=01:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/FlowSDF/sanity_check_%A.out

# Sanity-checks the already-trained FlowSDF experts (checkpoints/flowsdf,
# fine-tuned 2026-07-08/09) against the freshly-regenerated MedSAM embeddings
# (2026-08-19, job 25804827 --resume) on a small slice of the test split.
#
# Mirrors src/cnnROI/sanity_check_fresh_embeddings.job, but with a much
# smaller --limit: a CPU smoke test of oracle_route.py's flowsdf backend
# measured ~636s/image for the *dual*-expert case (8 ODE samples/image).
# This job only routes each fragment through its single assigned expert (the
# normal, non-oracle inference path), so roughly half that cost per image --
# still far heavier than cnnROI's single forward pass, hence --limit 10
# instead of 200. Even on GPU, budget generously until proven otherwise.
#
# If mean dice looks collapsed relative to the historical run (stepsize_40
# canonical run, 2026-07-07: mean dice 0.681 post-migration -- see
# project_flowsdf_stepsize_migration memory for why that number, not 0.908,
# is the right baseline to compare against), FlowSDF needs retraining before
# oracle routing/learned gating can be trusted.
#
# Output:
#   /scratch-shared/aramautar2/sanity_check_flowsdf/test/binary_masks/*.npz
#   /scratch-shared/aramautar2/sanity_check_flowsdf/evaluation_sanity.csv

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "========================================"

SANITY_DIR=/scratch-shared/aramautar2/sanity_check_flowsdf
PRED_DIR=$SANITY_DIR/test/binary_masks
mkdir -p "$PRED_DIR"

echo ""
echo "--- Step 1: FlowSDF MoE inference, 10 test images (single-routed, not oracle) ---"
python src/FlowSDF/infer_flowsdf_moe.py \
    --split test \
    --limit 10 \
    --output-root "$SANITY_DIR"

echo ""
echo "--- Step 2: evaluate against PENGWIN GT (dice + iou only, + delta vs MedSAM baseline) ---"
python evaluation/evaluate_moe_pengwin.py \
    --pred-mask-root "$PRED_DIR" \
    --output-csv     "$SANITY_DIR/evaluation_sanity.csv" \
    --medsam-csv     data/medsam-predictions/evaluation_pengwin.csv \
    --delta-csv      "$SANITY_DIR/evaluation_sanity_delta.csv" \
    --skip-boundary \
    --delta \
    --num-workers 8

echo ""
echo "=== sanity check summary (FlowSDF on fresh embeddings) ==="
python evaluation/summarize_eval_csv.py "$SANITY_DIR/evaluation_sanity.csv"

echo "========================================"
echo "end : $(date)"
echo "========================================"
