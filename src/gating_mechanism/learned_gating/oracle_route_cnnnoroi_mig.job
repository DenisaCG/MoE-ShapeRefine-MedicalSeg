#!/bin/bash

#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=oracle_route_cnnnoroi_mig
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=08:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/gating_mechanism/learned_gating/logs/oracle_route_cnnnoroi_mig_%A.out

# Race-partition twin of oracle_route_cnnnoroi.job (gpu_a100), submitted
# alongside gpu_a100/gpu_h100 variants so whichever partition starts first
# wins; a watcher cancels the other two. gpu_mig gives a100_3g.20gb slices
# (20GB, ~3/7 A100 compute) -- plenty for CNN inference-only forward passes
# (no training here), so it's a reasonable third contender. Identical
# workload/output -- see oracle_route_cnnnoroi.job for full description.

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "python  : $(which python)"
echo "========================================"

echo ""
echo "--- sanity check: embeddings must be complete before oracle labeling ---"
N_EMB=$(ls data/medsam-predictions/embeddings | wc -l)
echo "embeddings on disk: ${N_EMB}"
if [ "${N_EMB}" -lt 50000 ]; then
    echo "ERROR: expected 50000 embeddings, found ${N_EMB}. Wait for" \
         "1_infer_medsam_base.job (--resume) to finish before running this." >&2
    exit 1
fi

echo ""
echo "--- oracle-route all splits (train/val/test), backend=cnnnoroi ---"
python src/gating_mechanism/learned_gating/oracle_route.py --backend cnnnoroi --split all

echo "========================================"
echo "end : $(date)"
echo "========================================"
