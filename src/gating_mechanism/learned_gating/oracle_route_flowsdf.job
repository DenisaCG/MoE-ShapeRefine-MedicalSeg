#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=oracle_route_flowsdf
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=24:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/gating_mechanism/learned_gating/logs/oracle_route_flowsdf_%A.out

# Oracle expert-routing labels for the learned-gating classifier (FlowSDF backend).
#
# Runs BOTH already-trained FlowSDF experts (expert_small, expert_large) on
# every fragment across train/val/test -- not just the one each fragment was
# routed to -- and records which one actually scores higher Dice against GT.
# No training happens here; this only reads checkpoints/flowsdf/*_best.pth.
#
# Much slower than the cnnROI variant (oracle_route_cnnroi.job): each
# fragment needs a multi-step Euler-ODE sample through a 160M-param UNet per
# expert, vs. cnnROI's single forward pass. A CPU smoke test measured
# ~636s/image for just 4 fragments x 2 experts -- budget generously even on
# GPU. If this runs long, consider a --limit smoke test first, or reducing
# --n-eval / --ode-steps for a faster (noisier) pass.
#
# Prerequisite: data/medsam-predictions/embeddings must be the complete
# 50,000-file set (see project_pengwin_medsam_data_incident memory) -- do not
# run this against a partial embedding set.
#
# Output:
#   src/gating_mechanism/learned_gating/oracle_labels_flowsdf_{train,val,test}.csv

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "python  : $(which python)"
echo "========================================"

echo ""
echo "--- sanity check: embeddings must be complete before oracle labeling ---"
N_EMB=$(ls data/medsam-predictions/embeddings | wc -l)
echo "embeddings on disk: ${N_EMB}"
if [ "${N_EMB}" -lt 50000 ]; then
    echo "ERROR: expected 50000 embeddings, found ${N_EMB}. Wait for" \
         "1_infer_medsam_base.job (--resume) to finish before running this." >&2
    exit 1
fi

echo ""
echo "--- oracle-route all splits (train/val/test), backend=flowsdf ---"
python src/gating_mechanism/learned_gating/oracle_route.py --backend flowsdf --split all

echo "========================================"
echo "end : $(date)"
echo "========================================"
