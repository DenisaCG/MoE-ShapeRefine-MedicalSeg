#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=gating_ablation_strategy3_seed1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=12:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/gating_mechanism/gating_ablation/logs/strategy3_seed1_%A.out

# Gating ablation — Strategy 3 (extra seed): random routing baseline.
#   routing = random
#   seed    = 1
#   Preserves the same expert_small/expert_large ratio the canonical 5402
#   area threshold produces, computed independently per split (see
#   src/gating_mechanism/README.md, "Gating Ablation Study"). --threshold is
#   not passed here — random routing always targets the 5402-threshold ratio
#   regardless of --threshold (see compute_expert_column() in gating_mechanism.py).
#
# First of three extra random-routing seeds (alongside seed=99, seed=2026)
# run to add more draws to the seed=7/42/123 robustness check in
# INTERPRETATION.md ("Area-threshold vs. random routing — does the result
# hold across random seeds?").
#
# Pipeline: gate -> train cnnROI -> infer (test split) -> evaluate.
# All outputs are written under this strategy's own folder — the canonical
# gated_*.csv, checkpoints/cnnROI, and data/roi-predictions outputs used by
# the non-ablation pipeline (and the other gating-ablation strategies) are
# never touched.
#
# Outputs:
#   gating_ablation/strategy3_seed1/gating_csvs/gated_{train,val,test}_records.csv
#   gating_ablation/strategy3_seed1/checkpoints/{expert_small,expert_large}_{best,final}.pth
#   gating_ablation/strategy3_seed1/predictions/binary_masks/{sample_name}.npz
#   gating_ablation/strategy3_seed1/evaluation/evaluation_moe.csv
#   gating_ablation/strategy3_seed1/evaluation/evaluation_delta.csv

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "python  : $(which python)"
echo "========================================"

STRATEGY_DIR=src/gating_mechanism/gating_ablation/strategy3_seed1
GATING_CSV_DIR=$STRATEGY_DIR/gating_csvs
CHECKPOINT_DIR=$STRATEGY_DIR/checkpoints
PRED_DIR=$STRATEGY_DIR/predictions/binary_masks
EVAL_DIR=$STRATEGY_DIR/evaluation

mkdir -p "$GATING_CSV_DIR" "$CHECKPOINT_DIR" "$PRED_DIR" "$EVAL_DIR"

echo ""
echo "--- Step 1: generate gating CSVs (routing=random, seed=1, ratio-matched to threshold=5402) ---"
python src/gating_mechanism/gating_mechanism.py \
    --routing random \
    --seed 1 \
    --out-dir "$GATING_CSV_DIR"

echo ""
echo "--- Step 2: train cnnROI ---"
python src/cnnROI/train_roi.py \
    --expert both \
    --epochs 40 \
    --patience 10 \
    --batch-size 64 \
    --num-workers 8 \
    --large-subsample 17000 \
    --roi-size 64 \
    --roi-pad 64 \
    --gating-csv-dir "$GATING_CSV_DIR" \
    --checkpoint-dir "$CHECKPOINT_DIR" \
    --wandb-project moe-shaprefine-gating-ablation

echo ""
echo "--- Step 3: cnnROI inference on test split ---"
python src/cnnROI/infer_roi.py \
    --split test \
    --gating-csv-dir "$GATING_CSV_DIR" \
    --checkpoint-dir "$CHECKPOINT_DIR" \
    --output-dir "$PRED_DIR" \
    --roi-size 64 \
    --roi-pad 64

echo ""
echo "--- Step 4: evaluate against PENGWIN GT (+ delta vs MedSAM baseline) ---"
python evaluation/evaluate_moe_pengwin.py \
    --pred-mask-root "$PRED_DIR" \
    --output-csv     "$EVAL_DIR/evaluation_moe.csv" \
    --medsam-csv     data/medsam-predictions/evaluation_pengwin.csv \
    --delta-csv      "$EVAL_DIR/evaluation_delta.csv" \
    --num-workers 8 \
    --delta

echo ""
echo "=== strategy3 seed=1 (random) evaluation summary ==="
python evaluation/summarize_eval_csv.py "$EVAL_DIR/evaluation_moe.csv"

echo "========================================"
echo "end : $(date)"
echo "========================================"
