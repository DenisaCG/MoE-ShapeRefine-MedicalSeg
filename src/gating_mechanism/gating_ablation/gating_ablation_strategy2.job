#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=gating_ablation_strategy2
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=12:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/gating_mechanism/gating_ablation/logs/strategy2_%A.out

# Gating ablation — Strategy 2: alternative threshold.
#   routing   = area
#   threshold = 14188 foreground pixels
#
# Pipeline: gate -> train cnnROI -> infer (test split) -> evaluate.
# All outputs are written under this strategy's own folder — the canonical
# gated_*.csv, checkpoints/cnnROI, and data/roi-predictions outputs used by
# the non-ablation pipeline are never touched.
#
# Outputs:
#   gating_ablation/strategy2/gating_csvs/gated_{train,val,test}_records.csv
#   gating_ablation/strategy2/checkpoints/{expert_small,expert_large}_{best,final}.pth
#   gating_ablation/strategy2/predictions/binary_masks/{sample_name}.npz
#   gating_ablation/strategy2/evaluation/evaluation_moe.csv
#   gating_ablation/strategy2/evaluation/evaluation_delta.csv

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "python  : $(which python)"
echo "========================================"

STRATEGY_DIR=src/gating_mechanism/gating_ablation/strategy2
GATING_CSV_DIR=$STRATEGY_DIR/gating_csvs
CHECKPOINT_DIR=$STRATEGY_DIR/checkpoints
PRED_DIR=$STRATEGY_DIR/predictions/binary_masks
EVAL_DIR=$STRATEGY_DIR/evaluation

mkdir -p "$GATING_CSV_DIR" "$CHECKPOINT_DIR" "$PRED_DIR" "$EVAL_DIR"

echo ""
echo "--- Step 1: generate gating CSVs (routing=area, threshold=14188) ---"
python src/gating_mechanism/gating_mechanism.py \
    --threshold 14188 \
    --out-dir "$GATING_CSV_DIR"

echo ""
echo "--- Step 2: train cnnROI ---"
python src/cnnROI/train_roi.py \
    --expert both \
    --epochs 40 \
    --patience 10 \
    --batch-size 64 \
    --num-workers 8 \
    --large-subsample 17000 \
    --roi-size 64 \
    --roi-pad 64 \
    --gating-csv-dir "$GATING_CSV_DIR" \
    --checkpoint-dir "$CHECKPOINT_DIR" \
    --wandb-project moe-shaprefine-gating-ablation

echo ""
echo "--- Step 3: cnnROI inference on test split ---"
python src/cnnROI/infer_roi.py \
    --split test \
    --gating-csv-dir "$GATING_CSV_DIR" \
    --checkpoint-dir "$CHECKPOINT_DIR" \
    --output-dir "$PRED_DIR" \
    --roi-size 64 \
    --roi-pad 64

echo ""
echo "--- Step 4: evaluate against PENGWIN GT (+ delta vs MedSAM baseline) ---"
python evaluation/evaluate_moe_pengwin.py \
    --pred-mask-root "$PRED_DIR" \
    --output-csv     "$EVAL_DIR/evaluation_moe.csv" \
    --medsam-csv     data/medsam-predictions/evaluation_pengwin.csv \
    --delta-csv      "$EVAL_DIR/evaluation_delta.csv" \
    --num-workers 8 \
    --delta

echo ""
echo "=== strategy2 (area, threshold=14188) evaluation summary ==="
python evaluation/summarize_eval_csv.py "$EVAL_DIR/evaluation_moe.csv"

echo "========================================"
echo "end : $(date)"
echo "========================================"
