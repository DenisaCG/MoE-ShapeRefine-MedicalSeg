#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=gating_ablation_strategy3_seed99_a100race
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=12:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/gating_mechanism/gating_ablation/logs/strategy3_seed99_a100race_%A.out

# a100-partition race copy of gating_ablation_strategy3_seed99.job (gpu_h100 job 25945632),
# submitted because gpu_h100 was fully saturated (0 idle/mix nodes) while gpu_a100 had
# schedulable slack. Writes to its own strategy3_seed99_a100race/ folder (NOT
# strategy3_seed99/) so it cannot race-write the same checkpoint/CSV files as the gpu_h100
# copy. Whichever of the two finishes first should be treated as canonical; cancel the
# other and, if this a100 copy wins, either rename strategy3_seed99_a100race -> strategy3_seed99
# or update INTERPRETATION.md to point at this folder instead.

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "python  : $(which python)"
echo "========================================"

STRATEGY_DIR=src/gating_mechanism/gating_ablation/strategy3_seed99_a100race
GATING_CSV_DIR=$STRATEGY_DIR/gating_csvs
CHECKPOINT_DIR=$STRATEGY_DIR/checkpoints
PRED_DIR=$STRATEGY_DIR/predictions/binary_masks
EVAL_DIR=$STRATEGY_DIR/evaluation

mkdir -p "$GATING_CSV_DIR" "$CHECKPOINT_DIR" "$PRED_DIR" "$EVAL_DIR"

echo ""
echo "--- Step 1: generate gating CSVs (routing=random, seed=99, ratio-matched to threshold=5402) ---"
python src/gating_mechanism/gating_mechanism.py \
    --routing random \
    --seed 99 \
    --out-dir "$GATING_CSV_DIR"

echo ""
echo "--- Step 2: train cnnROI ---"
python src/cnnROI/train_roi.py \
    --expert both \
    --epochs 40 \
    --patience 10 \
    --batch-size 64 \
    --num-workers 8 \
    --large-subsample 17000 \
    --roi-size 64 \
    --roi-pad 64 \
    --gating-csv-dir "$GATING_CSV_DIR" \
    --checkpoint-dir "$CHECKPOINT_DIR" \
    --wandb-project moe-shaprefine-gating-ablation

echo ""
echo "--- Step 3: cnnROI inference on test split ---"
python src/cnnROI/infer_roi.py \
    --split test \
    --gating-csv-dir "$GATING_CSV_DIR" \
    --checkpoint-dir "$CHECKPOINT_DIR" \
    --output-dir "$PRED_DIR" \
    --roi-size 64 \
    --roi-pad 64

echo ""
echo "--- Step 4: evaluate against PENGWIN GT (+ delta vs MedSAM baseline) ---"
python evaluation/evaluate_moe_pengwin.py \
    --pred-mask-root "$PRED_DIR" \
    --output-csv     "$EVAL_DIR/evaluation_moe.csv" \
    --medsam-csv     data/medsam-predictions/evaluation_pengwin.csv \
    --delta-csv      "$EVAL_DIR/evaluation_delta.csv" \
    --num-workers 8 \
    --delta

echo ""
echo "=== strategy3 seed=99 (random) evaluation summary [a100 race copy] ==="
python evaluation/summarize_eval_csv.py "$EVAL_DIR/evaluation_moe.csv"

echo "========================================"
echo "end : $(date)"
echo "========================================"
