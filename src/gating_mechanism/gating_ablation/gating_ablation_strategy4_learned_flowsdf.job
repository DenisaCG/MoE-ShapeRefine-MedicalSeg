#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=gating_ablation_strategy4_learned_flowsdf
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=06:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/gating_mechanism/gating_ablation/logs/strategy4_learned_flowsdf_%A.out

# Gating ablation -- Strategy 4: learned routing (FlowSDF backend).
#   routing = learned (logistic regression on shape descriptors, see
#             learned_gating/train_classifier.py)
#
# Unlike strategy1/2/3, this does NOT retrain FlowSDF experts -- it reuses
# the already-trained checkpoints/flowsdf/expert_{small,large}_best.pth as-is
# and only swaps which expert each test fragment is routed to.
#
# Sibling of gating_ablation_strategy4_learned_cnnroi.job -- same pattern,
# swapped for FlowSDF's infer_flowsdf_moe.py (multi-step Euler-ODE SDF
# sampling per fragment, far heavier than a single CNN forward pass -- hence
# the longer time budget than the cnnroi/cnnnoroi variants, even though this
# only runs the test split, not all three).
#
# Prerequisites:
#   - data_distribution_results/data_analysis_medsam/features.csv must be
#     current (see recompute_medsam_features.job)
#   - checkpoints/gating_classifier/flowsdf_logreg.joblib must exist (see
#     learned_gating/train_classifier.py --backend flowsdf)
#
# Outputs:
#   gating_ablation/strategy4_learned_flowsdf/gating_csvs/gated_{train,val,test}_records.csv
#   gating_ablation/strategy4_learned_flowsdf/predictions/test/binary_masks/{sample_name}.npz
#   gating_ablation/strategy4_learned_flowsdf/evaluation/evaluation_moe.csv
#   gating_ablation/strategy4_learned_flowsdf/evaluation/evaluation_delta.csv

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "python  : $(which python)"
echo "========================================"

STRATEGY_DIR=src/gating_mechanism/gating_ablation/strategy4_learned_flowsdf
GATING_CSV_DIR=$STRATEGY_DIR/gating_csvs
CHECKPOINT_DIR=checkpoints/flowsdf
PRED_ROOT=$STRATEGY_DIR/predictions
PRED_DIR=$PRED_ROOT/test/binary_masks
EVAL_DIR=$STRATEGY_DIR/evaluation

mkdir -p "$GATING_CSV_DIR" "$PRED_DIR" "$EVAL_DIR"

echo ""
echo "--- Step 1: generate gating CSVs (routing=learned, backend=flowsdf) ---"
python src/gating_mechanism/gating_mechanism.py \
    --routing learned \
    --classifier-path checkpoints/gating_classifier/flowsdf_logreg.joblib \
    --out-dir "$GATING_CSV_DIR"

echo ""
echo "--- Step 2: (skipped) reusing already-trained FlowSDF experts ---"
echo "checkpoint dir: $CHECKPOINT_DIR"
ls "$CHECKPOINT_DIR"/expert_*_best.pth

echo ""
echo "--- Step 3: FlowSDF inference on test split ---"
python src/FlowSDF/infer_flowsdf_moe.py \
    --split test \
    --gating-csv-dir "$GATING_CSV_DIR" \
    --checkpoint-dir "$CHECKPOINT_DIR" \
    --output-root "$PRED_ROOT"

echo ""
echo "--- Step 4: evaluate against PENGWIN GT (+ delta vs MedSAM baseline) ---"
python evaluation/evaluate_moe_pengwin.py \
    --pred-mask-root "$PRED_DIR" \
    --output-csv     "$EVAL_DIR/evaluation_moe.csv" \
    --medsam-csv     data/medsam-predictions/evaluation_pengwin.csv \
    --delta-csv      "$EVAL_DIR/evaluation_delta.csv" \
    --num-workers 8 \
    --delta

echo ""
echo "=== strategy4_learned (routing=learned, flowsdf backend) evaluation summary ==="
python evaluation/summarize_eval_csv.py "$EVAL_DIR/evaluation_moe.csv"

echo "========================================"
echo "end : $(date)"
echo "========================================"
