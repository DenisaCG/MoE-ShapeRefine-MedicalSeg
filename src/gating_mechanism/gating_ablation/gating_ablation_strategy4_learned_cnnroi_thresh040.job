#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=gating_ablation_strategy4_learned_cnnroi_thresh040
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/gating_mechanism/gating_ablation/logs/strategy4_learned_cnnroi_thresh040_%A.out

# Gating ablation -- Strategy 4 variant: learned routing (cnnROI backend),
# with the expert_small probability cutoff lowered from the sklearn default
# (0.5) to 0.40. Threshold sweep on val (2026-08-21, see INTERPRETATION.md's
# "Oracle agreement" section) found 0.40 is a genuine local accuracy peak on
# BOTH val and held-out test, recovering expert_small recall from 0.06 to
# 0.46 without the precision collapse a naive class_weight="balanced" caused.
# This job checks whether that translates into better downstream Dice than
# the threshold=0.5 run (strategy4_learned_cnnroi, jobs 25913246), which lost
# -0.66pp Dice on small fragments specifically.
#
# Sibling of gating_ablation_strategy4_learned_cnnroi.job -- identical except
# for --learned-threshold 0.40 and a separate output directory so the
# threshold=0.5 results aren't overwritten.
#
# Prerequisites: same as gating_ablation_strategy4_learned_cnnroi.job.

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "python  : $(which python)"
echo "========================================"

STRATEGY_DIR=src/gating_mechanism/gating_ablation/strategy4_learned_cnnroi_thresh040
GATING_CSV_DIR=$STRATEGY_DIR/gating_csvs
CHECKPOINT_DIR=checkpoints/cnnROI
PRED_DIR=$STRATEGY_DIR/predictions/binary_masks
EVAL_DIR=$STRATEGY_DIR/evaluation

mkdir -p "$GATING_CSV_DIR" "$PRED_DIR" "$EVAL_DIR"

echo ""
echo "--- Step 1: generate gating CSVs (routing=learned, backend=cnnroi, threshold=0.40) ---"
python src/gating_mechanism/gating_mechanism.py \
    --routing learned \
    --classifier-path checkpoints/gating_classifier/cnnroi_logreg.joblib \
    --learned-threshold 0.40 \
    --out-dir "$GATING_CSV_DIR"

echo ""
echo "--- Step 2: (skipped) reusing already-trained cnnROI experts ---"
echo "checkpoint dir: $CHECKPOINT_DIR"
ls "$CHECKPOINT_DIR"/expert_*_best.pth

echo ""
echo "--- Step 3: cnnROI inference on test split ---"
python src/cnnROI/infer_roi.py \
    --split test \
    --gating-csv-dir "$GATING_CSV_DIR" \
    --checkpoint-dir "$CHECKPOINT_DIR" \
    --output-dir "$PRED_DIR" \
    --roi-size 64 \
    --roi-pad 64

echo ""
echo "--- Step 4: evaluate against PENGWIN GT (+ delta vs MedSAM baseline) ---"
python evaluation/evaluate_moe_pengwin.py \
    --pred-mask-root "$PRED_DIR" \
    --output-csv     "$EVAL_DIR/evaluation_moe.csv" \
    --medsam-csv     data/medsam-predictions/evaluation_pengwin.csv \
    --delta-csv      "$EVAL_DIR/evaluation_delta.csv" \
    --num-workers 8 \
    --delta

echo ""
echo "=== strategy4_learned (routing=learned, cnnroi backend, threshold=0.40) evaluation summary ==="
python evaluation/summarize_eval_csv.py "$EVAL_DIR/evaluation_moe.csv"

echo "========================================"
echo "end : $(date)"
echo "========================================"
