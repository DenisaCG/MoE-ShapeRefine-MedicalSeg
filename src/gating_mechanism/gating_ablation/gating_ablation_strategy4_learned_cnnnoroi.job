#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=gating_ablation_strategy4_learned_cnnnoroi
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/gating_mechanism/gating_ablation/logs/strategy4_learned_cnnnoroi_%A.out

# Gating ablation -- Strategy 4: learned routing (cnnNoROI backend).
#   routing = learned (logistic regression on shape descriptors, see
#             learned_gating/train_classifier.py)
#
# Unlike strategy1/2/3, this does NOT retrain cnnNoROI experts -- it reuses
# the already-trained checkpoints/cnnNoROI/expert_{small,large}_best.pth as-is
# and only swaps which expert each test fragment is routed to. This isolates
# the effect of the routing rule itself from any effect of retraining on a
# differently-shaped split, at a fraction of a full-retrain strategy's cost.
#
# Sibling of gating_ablation_strategy4_learned_cnnroi.job -- same pattern,
# swapped for cnnNoROI's infer_moe.py (no RoI-crop step, so no
# --roi-size/--roi-pad args).
#
# Prerequisites:
#   - data_distribution_results/data_analysis_medsam/features.csv must be
#     current (see recompute_medsam_features.job)
#   - checkpoints/gating_classifier/cnnnoroi_logreg.joblib must exist (see
#     learned_gating/train_classifier.py --backend cnnnoroi)
#
# Outputs:
#   gating_ablation/strategy4_learned_cnnnoroi/gating_csvs/gated_{train,val,test}_records.csv
#   gating_ablation/strategy4_learned_cnnnoroi/predictions/binary_masks/{sample_name}.npz
#   gating_ablation/strategy4_learned_cnnnoroi/evaluation/evaluation_moe.csv
#   gating_ablation/strategy4_learned_cnnnoroi/evaluation/evaluation_delta.csv

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "python  : $(which python)"
echo "========================================"

STRATEGY_DIR=src/gating_mechanism/gating_ablation/strategy4_learned_cnnnoroi
GATING_CSV_DIR=$STRATEGY_DIR/gating_csvs
CHECKPOINT_DIR=checkpoints/cnnNoROI
PRED_DIR=$STRATEGY_DIR/predictions/binary_masks
EVAL_DIR=$STRATEGY_DIR/evaluation

mkdir -p "$GATING_CSV_DIR" "$PRED_DIR" "$EVAL_DIR"

echo ""
echo "--- Step 1: generate gating CSVs (routing=learned, backend=cnnnoroi) ---"
python src/gating_mechanism/gating_mechanism.py \
    --routing learned \
    --classifier-path checkpoints/gating_classifier/cnnnoroi_logreg.joblib \
    --out-dir "$GATING_CSV_DIR"

echo ""
echo "--- Step 2: (skipped) reusing already-trained cnnNoROI experts ---"
echo "checkpoint dir: $CHECKPOINT_DIR"
ls "$CHECKPOINT_DIR"/expert_*_best.pth

echo ""
echo "--- Step 3: cnnNoROI inference on test split ---"
python src/cnnNoROI/infer_moe.py \
    --split test \
    --gating-csv-dir "$GATING_CSV_DIR" \
    --checkpoint-dir "$CHECKPOINT_DIR" \
    --output-dir "$PRED_DIR"

echo ""
echo "--- Step 4: evaluate against PENGWIN GT (+ delta vs MedSAM baseline) ---"
python evaluation/evaluate_moe_pengwin.py \
    --pred-mask-root "$PRED_DIR" \
    --output-csv     "$EVAL_DIR/evaluation_moe.csv" \
    --medsam-csv     data/medsam-predictions/evaluation_pengwin.csv \
    --delta-csv      "$EVAL_DIR/evaluation_delta.csv" \
    --num-workers 8 \
    --delta

echo ""
echo "=== strategy4_learned (routing=learned, cnnnoroi backend) evaluation summary ==="
python evaluation/summarize_eval_csv.py "$EVAL_DIR/evaluation_moe.csv"

echo "========================================"
echo "end : $(date)"
echo "========================================"
