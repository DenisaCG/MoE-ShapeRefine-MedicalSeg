#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=smoke_gating_ablation
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=00:30:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/gating_mechanism/gating_ablation/smoke_test/slurm_smoke_gating_ablation_%A.out

# Smoke test for the CNN-ROI gating ablation study (see src/gating_mechanism/README.md,
# "Gating Ablation Study" section). Verifies the new gating_mechanism.py CLI options
# (--threshold, --routing, --seed, --out-dir) and cnnROI's --gating-csv-dir wiring work
# end-to-end, on a tiny 5-cases-per-split subset. This does NOT train a real model —
# --epochs 1 and --expert expert_large only (expert_small is likely empty at this scale;
# the small-fragment ratio is ~8%, so 5 smoke cases may yield zero expert_small
# fragments). Everything is written under gating_ablation/smoke_test/, never touching
# the canonical gated_*.csv or checkpoints/cnnROI outputs.
#
# Outputs:
#   gating_ablation/smoke_test/gating_csvs_area/gated_{train,val,test}_records.csv
#   gating_ablation/smoke_test/gating_csvs_random/gated_{train,val,test}_records.csv
#   gating_ablation/smoke_test/checkpoints/expert_large_{best,final}.pth (+ loss curve)

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "python  : $(which python)"
echo "========================================"

SMOKE_DIR=src/gating_mechanism/gating_ablation/smoke_test
GATING_CSV_AREA=$SMOKE_DIR/gating_csvs_area
GATING_CSV_RANDOM=$SMOKE_DIR/gating_csvs_random
CHECKPOINT_DIR=$SMOKE_DIR/checkpoints

mkdir -p "$GATING_CSV_AREA" "$GATING_CSV_RANDOM" "$CHECKPOINT_DIR"

echo ""
echo "--- Step 1a: smoke gating CSVs, --routing area --threshold 5402 ---"
python src/gating_mechanism/gating_mechanism.py \
    --smoke \
    --threshold 5402 \
    --out-dir "$GATING_CSV_AREA"

echo ""
echo "--- Step 1b: smoke gating CSVs, --routing random --seed 42 ---"
python src/gating_mechanism/gating_mechanism.py \
    --smoke \
    --routing random \
    --seed 42 \
    --out-dir "$GATING_CSV_RANDOM"

echo ""
echo "--- Step 2: verify cnnROI train_roi.py starts with --gating-csv-dir (expert_large, 1 epoch) ---"
python src/cnnROI/train_roi.py \
    --expert expert_large \
    --epochs 1 \
    --patience 1 \
    --batch-size 2 \
    --num-workers 2 \
    --roi-size 64 \
    --roi-pad 64 \
    --gating-csv-dir "$GATING_CSV_AREA" \
    --checkpoint-dir "$CHECKPOINT_DIR" \
    --no-wandb

echo ""
echo "Smoke test finished — gating CSV generation and cnnROI --gating-csv-dir startup both verified."

echo "========================================"
echo "end : $(date)"
echo "========================================"
