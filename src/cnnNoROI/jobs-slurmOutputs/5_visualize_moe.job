#!/bin/bash

#SBATCH --partition=rome
#SBATCH --job-name=visualize_moe_cnnNoROI
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --time=00:30:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/cnnNoROI/slurm_visualize_moe_%A.out

# Generates side-by-side PNG figures for selected fragments:
#   X-ray | MedSAM | MoE refined | GT | Diff
# Requires infer_moe.job and evaluate_moe.job to have completed first
# (needs evaluation_delta.csv).
#
# Output: data/moe-predictions/visualizations/*.png

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id : ${SLURM_JOB_ID}"
echo "host   : $(hostname)"
echo "start  : $(date)"
echo "========================================"

python evaluation/visualize_moe_pengwin.py \
    --n-best 5 \
    --n-worst 5 \
    --n-random-small 5 \
    --n-random-large 5

echo "========================================"
echo "end : $(date)"
echo "========================================"
