#!/bin/bash

#SBATCH --partition=rome
#SBATCH --job-name=evaluate_moe_cnnNoROI
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg/src/cnnNoROI/slurm_evaluate_moe_%A.out

# Evaluates MoE refined masks against PENGWIN GT (Dice, IoU, HD95, ASSD).
# Also computes a delta CSV comparing MoE vs MedSAM baseline per fragment.
# Requires infer_moe.job to have completed first.
#
# Outputs:
#   data/moe-predictions/evaluation_moe.csv      per-fragment metrics
#   data/moe-predictions/evaluation_delta.csv    MoE - MedSAM delta per fragment

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "========================================"

# Step 1 — evaluate MoE predictions (full metrics including HD95 and ASSD)
python evaluation/evaluate_moe_pengwin.py \
    --num-workers 8 \
    --delta

# Step 2 — print clean per-class / per-size summary table
echo ""
echo "=== MoE evaluation summary ==="
python evaluation/summarize_eval_csv.py \
    data/moe-predictions/evaluation_moe.csv

# Step 3 — print MedSAM baseline summary for comparison
echo ""
echo "=== MedSAM baseline summary ==="
python evaluation/summarize_eval_csv.py \
    data/medsam-predictions/evaluation_pengwin.csv 2>/dev/null || \
    echo "MedSAM baseline CSV not found — run evaluate_medsam_pengwin.py first if you want the comparison."

echo "========================================"
echo "end : $(date)"
echo "========================================"
