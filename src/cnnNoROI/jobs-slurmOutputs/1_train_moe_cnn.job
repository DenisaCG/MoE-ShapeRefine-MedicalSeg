#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=train_moe_cnnNoROI
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=08:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/cnnNoROI/slurm_train_moe_%A.out

# cpus-per-task=9: standard allocation for one MIG slice on Snellius.
# 8 CPUs go to DataLoader workers (--num-workers 8), 1 to the main process.
# gpu_mig gives a 1g.10gb A100 slice (~10 GB VRAM). Peak GPU usage here is
# ~300 MB, so the slice is ample and queue wait is much shorter than gpu_a100.

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "python  : $(which python)"
echo "========================================"

python src/cnnNoROI/train_moe.py \
    --expert both \
    --epochs 40 \
    --patience 10 \
    --batch-size 64 \
    --num-workers 8 \
    --large-subsample 17000 \
    --wandb-project moe-shaprefine

echo "========================================"
echo "end : $(date)"
echo "========================================"
