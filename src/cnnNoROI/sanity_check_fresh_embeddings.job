#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=sanity_check_cnnnoroi
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=00:30:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/src/cnnNoROI/sanity_check_%A.out

# Sanity-checks the already-trained cnnNoROI experts (checkpoints/cnnNoROI)
# against the freshly-regenerated MedSAM embeddings (2026-08-19, job 25804827
# --resume) on a small slice of the test split. Mirrors
# src/cnnROI/sanity_check_fresh_embeddings.job -- same MedSAM embeddings/masks,
# same CNNExpert architecture, just without the RoI-crop step (see
# infer_moe.py vs infer_roi.py), so it's exposed to the same potential
# staleness risk as cnnROI.
#
# Compare mean dice against the historical baseline before trusting oracle
# labels built on these checkpoints -- check slurm_evaluate_moe_24425093.out
# (or an equivalent canonical full-test-set cnnNoROI evaluation) for the
# real number; don't guess from memory (see project_learned_gating_implementation
# memory -- an earlier "~0.85-0.9" guess for cnnROI turned out wrong, the real
# baseline was 0.80).
#
# Output:
#   /scratch-shared/aramautar2/sanity_check_cnnnoroi/evaluation_sanity.csv

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "========================================"

SANITY_DIR=/scratch-shared/aramautar2/sanity_check_cnnnoroi
PRED_DIR=$SANITY_DIR/binary_masks
mkdir -p "$PRED_DIR"

echo ""
echo "--- Step 1: cnnNoROI inference, 200 test images ---"
python src/cnnNoROI/infer_moe.py \
    --split test \
    --limit 200 \
    --output-dir "$PRED_DIR"

echo ""
echo "--- Step 2: evaluate against PENGWIN GT (dice + iou only, + delta vs MedSAM baseline) ---"
python evaluation/evaluate_moe_pengwin.py \
    --pred-mask-root "$PRED_DIR" \
    --output-csv     "$SANITY_DIR/evaluation_sanity.csv" \
    --medsam-csv     data/medsam-predictions/evaluation_pengwin.csv \
    --delta-csv      "$SANITY_DIR/evaluation_sanity_delta.csv" \
    --skip-boundary \
    --delta \
    --num-workers 8

echo ""
echo "=== sanity check summary (cnnNoROI on fresh embeddings) ==="
python evaluation/summarize_eval_csv.py "$SANITY_DIR/evaluation_sanity.csv"

echo "========================================"
echo "end : $(date)"
echo "========================================"
