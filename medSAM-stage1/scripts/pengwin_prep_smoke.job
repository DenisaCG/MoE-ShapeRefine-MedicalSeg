#!/bin/bash
#SBATCH --job-name=pengwin_prep_smoke
#SBATCH --partition=rome
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=00:30:00
#SBATCH --output=slurm_prep_smoke_%j.out

module purge
module load 2024
module load Anaconda3/2024.06-1

source activate MoE
cd /gpfs/home5/aramautar2/projects || exit 1

python3 MedSAM/scripts/prepare_pengwin_xray_for_medsam.py \
  --limit 5 \
  --output-root /gpfs/home5/aramautar2/projects/data/pengwin/derived/medsam/xray_smoketest
