#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=train_medsam_pengwin
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --time=48:00:00
#SBATCH --output=/gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg/medSAM-stage1/scripts/jobs-slurmOutputs/slurm_train_medsam_pengwin_%A.out

# Fine-tunes MedSAM on PENGWIN X-ray data using gated_train_records.csv split.
# Saves best checkpoint (by val loss) to /scratch-shared/scur0509/checkpoints/medsam-finetuned/.
# After completion, feed the checkpoint into the inference pipeline via:
#   submit_pipeline.sh (uses --finetuned-ckpt automatically)

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/scur0509/projects/MoE-ShapeRefine-MedicalSeg

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "========================================"

python medSAM-stage1/train_medsam_pengwin.py \
    --epochs        10 \
    --batch-size    4 \
    --num-workers   4 \
    --lr            1e-4 \
    --bbox-shift    20

echo "========================================"
echo "end : $(date)"
echo "========================================"
