#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=train_medsam_pengwin_40ep
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --time=120:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/medSAM-stage1/scripts/jobs-slurmOutputs/slurm_train_medsam_pengwin_40ep_%A.out

# Continuation of 2_train_medsam_pengwin_20ep.job (job 25935579): picks up its finished
# 20-epoch checkpoint and trains on to 40 epochs total. Submitted with
# --dependency=afterok:25935579 so it only starts once that run has actually completed
# 20 full epochs (its --patience 20 == --epochs 20 means early stopping cannot cut it
# short, so a real 20-epoch checkpoint is guaranteed to exist by the time this starts).
#
# Uses its OWN checkpoint dir (medsam-finetuned-40ep), never the 20ep run's dir directly,
# so the verified 20-epoch checkpoint (medsam-finetuned-20ep/*) is never overwritten and
# stays intact as its own artifact. The 20ep checkpoint is only used once, to *seed* this
# dir's medsam_pengwin_latest.pth on first launch.
#
# Resumable by default, same pattern as 2_train_medsam_pengwin_20ep.job: after the seed
# copy, --resume always points at this dir's own medsam_pengwin_latest.pth, so if this job
# is interrupted (walltime, preemption, crash), just resubmit this same file unchanged --
# the seed step is a no-op once this dir already has its own checkpoint, and training
# continues from wherever it actually left off (not back at epoch 20).
#
# --epochs 40 / --patience 40 (>= epochs) so early stopping cannot cut this run short
# either -- the goal is a checkpoint that has actually seen 40 full epochs.
#
# Projected duration for the 20 additional epochs: ~80h, same per-epoch rate as
# 2_train_medsam_pengwin_20ep.job (~3.98h/epoch, extrapolated from 23999267's 10-epoch
# run). --time is set to gpu_h100's 120h partition max for headroom.

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

CKPT_DIR=/scratch-shared/aramautar2/checkpoints/medsam-finetuned-40ep
SEED_CKPT=/scratch-shared/aramautar2/checkpoints/medsam-finetuned-20ep/medsam_pengwin_latest.pth
mkdir -p "$CKPT_DIR"

if [ ! -f "$CKPT_DIR/medsam_pengwin_latest.pth" ]; then
    echo "Seeding $CKPT_DIR from completed 20-epoch run: $SEED_CKPT"
    cp "$SEED_CKPT" "$CKPT_DIR/medsam_pengwin_latest.pth"
else
    echo "Resuming from this run's own checkpoint (not re-seeding from 20ep run)."
fi

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "ckpt dir: ${CKPT_DIR}"
echo "========================================"

START_TS=$(date +%s)

python medSAM-stage1/train_medsam_pengwin.py \
    --epochs         40 \
    --patience        40 \
    --batch-size      4 \
    --num-workers     4 \
    --lr              1e-4 \
    --bbox-shift      20 \
    --checkpoint-dir  "$CKPT_DIR" \
    --resume          "$CKPT_DIR/medsam_pengwin_latest.pth"

END_TS=$(date +%s)
ELAPSED=$((END_TS - START_TS))

echo "========================================"
echo "end     : $(date)"
printf 'elapsed : %02dh:%02dm:%02ds (%d s)\n' $((ELAPSED/3600)) $((ELAPSED%3600/60)) $((ELAPSED%60)) "$ELAPSED"
echo "========================================"
