#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=train_medsam_pengwin_20ep_a100race
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --time=120:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/medSAM-stage1/scripts/jobs-slurmOutputs/slurm_train_medsam_pengwin_20ep_a100race_%A.out

# a100-partition race copy of 2_train_medsam_pengwin_20ep.job (gpu_h100 job 25935579),
# submitted because gpu_h100 was fully saturated (0 idle/mix nodes) while gpu_a100 had
# schedulable slack. Writes to its own checkpoint dir (medsam-finetuned-20ep-a100race/,
# NOT medsam-finetuned-20ep/) so it cannot race-write the same medsam_pengwin_latest.pth
# as the gpu_h100 copy.
#
# NOTE: the already-queued downstream chain (infer/evaluate/summarize, jobs 25935604-6,
# and the 40ep continuation 25943515-8) is pinned via --dependency=afterok to job
# 25935579 specifically -- it will NOT pick up this a100 copy's checkpoint automatically.
# If this a100 copy finishes first, either:
#   (a) cancel the gpu_h100 original (25935579) and manually resubmit the downstream
#       chain pointed at medsam-finetuned-20ep-a100race/, or
#   (b) copy medsam-finetuned-20ep-a100race/medsam_pengwin_latest.pth over to
#       medsam-finetuned-20ep/ once 25935579 is cancelled, so the existing chain's
#       hardcoded CKPT_DIR resolves to this result.
# Whichever finishes first should be treated as canonical; cancel the other.

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

CKPT_DIR=/scratch-shared/aramautar2/checkpoints/medsam-finetuned-20ep-a100race
mkdir -p "$CKPT_DIR"

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "ckpt dir: ${CKPT_DIR}"
echo "========================================"

START_TS=$(date +%s)

python medSAM-stage1/train_medsam_pengwin.py \
    --epochs         20 \
    --patience        20 \
    --batch-size      4 \
    --num-workers     4 \
    --lr              1e-4 \
    --bbox-shift      20 \
    --checkpoint-dir  "$CKPT_DIR" \
    --resume          "$CKPT_DIR/medsam_pengwin_latest.pth"

END_TS=$(date +%s)
ELAPSED=$((END_TS - START_TS))

echo "========================================"
echo "end     : $(date)"
printf 'elapsed : %02dh:%02dm:%02ds (%d s)\n' $((ELAPSED/3600)) $((ELAPSED%3600/60)) $((ELAPSED%60)) "$ELAPSED"
echo "========================================"
