#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=train_medsam_pengwin_20ep
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --time=120:00:00
#SBATCH --output=/gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg/medSAM-stage1/scripts/jobs-slurmOutputs/slurm_train_medsam_pengwin_20ep_%A.out

# Full 20-epoch fine-tune of MedSAM on PENGWIN X-ray data (gated_train/val_records.csv split).
# Distinct from 1_train_medsam_pengwin.job (10 epochs, Jun 2026, its output checkpoint dir
# has since been purged from /scratch-shared) — this run uses its own checkpoint dir so it
# is never ambiguous which run produced which checkpoint.
#
# Projected duration: ~80h, extrapolated linearly from the 10-epoch run (23999267:
# 39h46m, ~3.98h/epoch). --time is set to gpu_h100's 120h partition max for headroom.
# --patience is raised to 20 (>= --epochs) so early stopping cannot cut this run short --
# the goal is a checkpoint that has actually seen 20 full epochs.
#
# Resumable by default: if this job is interrupted (walltime, preemption, crash), just
# resubmit this same file unchanged -- --resume points at medsam_pengwin_latest.pth, which
# is a no-op the first time (file doesn't exist yet) and picks up where it left off after.

set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source /sw/arch/RHEL9/EB_production/2024/software/Anaconda3/2024.06-1/etc/profile.d/conda.sh
conda activate MoE

cd /gpfs/home5/aramautar2/projects/MoE-ShapeRefine-MedicalSeg

CKPT_DIR=/scratch-shared/aramautar2/checkpoints/medsam-finetuned-20ep
mkdir -p "$CKPT_DIR"

echo "========================================"
echo "job id  : ${SLURM_JOB_ID}"
echo "host    : $(hostname)"
echo "start   : $(date)"
echo "gpu     : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'n/a')"
echo "ckpt dir: ${CKPT_DIR}"
echo "========================================"

START_TS=$(date +%s)

python medSAM-stage1/train_medsam_pengwin.py \
    --epochs         20 \
    --patience        20 \
    --batch-size      4 \
    --num-workers     4 \
    --lr              1e-4 \
    --bbox-shift      20 \
    --checkpoint-dir  "$CKPT_DIR" \
    --resume          "$CKPT_DIR/medsam_pengwin_latest.pth"

END_TS=$(date +%s)
ELAPSED=$((END_TS - START_TS))

echo "========================================"
echo "end     : $(date)"
printf 'elapsed : %02dh:%02dm:%02ds (%d s)\n' $((ELAPSED/3600)) $((ELAPSED%3600/60)) $((ELAPSED%60)) "$ELAPSED"
echo "========================================"
